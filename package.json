{
  "name": "ksefbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "migrate": "node --experimental-strip-types src/db/migrate-cli.ts"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "zod": "^3.23.8",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "@types/pg": "^8.11.10"
  }
}
